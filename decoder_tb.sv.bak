module decoder_tb;

    logic I1, I0, I1f, I0f;
    logic O1, O0;

    decoder (I1, I0, I1f, I0f, O1, O0);

    initial begin
        {I1, I0, I1f, I0f} = 4'b0000; #10; $display("Input: 0000. Output: %b%b", O1, O0);
        {I1, I0, I1f, I0f} = 4'b0001; #10; $display("Input: 0001. Output: %b%b", O1, O0);
        {I1, I0, I1f, I0f} = 4'b0010; #10; $display("Input: 0010. Output: %b%b", O1, O0);
        {I1, I0, I1f, I0f} = 4'b0011; #10; $display("Input: 0011. Output: %b%b", O1, O0);
        {I1, I0, I1f, I0f} = 4'b0100; #10; $display("Input: 0100. Output: %b%b", O1, O0);
        {I1, I0, I1f, I0f} = 4'b0101; #10; $display("Input: 0101. Output: %b%b", O1, O0);
        {I1, I0, I1f, I0f} = 4'b0110; #10; $display("Input: 0110. Output: %b%b", O1, O0);
        {I1, I0, I1f, I0f} = 4'b0111; #10; $display("Input: 0111. Output: %b%b", O1, O0);
        {I1, I0, I1f, I0f} = 4'b1000; #10; $display("Input: 1000. Output: %b%b", O1, O0);
        {I1, I0, I1f, I0f} = 4'b1001; #10; $display("Input: 1001. Output: %b%b", O1, O0);
        {I1, I0, I1f, I0f} = 4'b1010; #10; $display("Input: 1010. Output: %b%b", O1, O0);
        {I1, I0, I1f, I0f} = 4'b1011; #10; $display("Input: 1011. Output: %b%b", O1, O0);
        {I1, I0, I1f, I0f} = 4'b1100; #10; $display("Input: 1100. Output: %b%b", O1, O0);
        {I1, I0, I1f, I0f} = 4'b1101; #10; $display("Input: 1101. Output: %b%b", O1, O0);
        {I1, I0, I1f, I0f} = 4'b1110; #10; $display("Input: 1110. Output: %b%b", O1, O0);
        {I1, I0, I1f, I0f} = 4'b1111; #10; $display("Input: 1111. Output: %b%b", O1, O0);
        $finish;
    end

endmodule
